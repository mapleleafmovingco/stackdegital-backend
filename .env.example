# Copy to .env and fill in. Never commit .env.

# Supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Public by design. Not read by this server; kept alongside for reference.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Backend only. Bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Optional: defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=

# Stripe (use test keys locally, live keys only in production)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# App
# Frontend origin: used for CORS and for the Checkout return URLs.
APP_URL=http://localhost:8080
PORT=4000
# Number of reverse proxies in front of this server in production (0 = none).
# TRUST_PROXY=1

